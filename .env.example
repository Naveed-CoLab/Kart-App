# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: defaults to PAYPAL_CLIENT_ID (it's public)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox Store business account: receives the shopper's payment directly (PayPal payee)
STORE_PAYPAL_EMAIL=
# Optional: different sandbox stores per domain, JSON: {"bestbuy.com":"store1@...","target.com":"store2@..."}
STORE_PAYEES=
# Sandbox Shopper personal account email (fallback for Kart Guarantee payouts)
SHOPPER_PAYPAL_EMAIL=
# From developer.paypal.com > your app > Webhooks (after you deploy)
PAYPAL_WEBHOOK_ID=

# --- Channel3 (trychannel3.com/developers) ---
CHANNEL3_API_KEY=

# --- Kart ---
# Any long random string; signs approval tokens
# Signs sessions and approval tokens. Required in production: 32+ random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_SECRET=
KART_FEE_RATE=0.05
# Your public URL (used for PayPal return URLs). Local: http://localhost:3000
APP_URL=http://localhost:3000

# Store checkout step: "demo" (sandbox, simulated store order) or "live"
STORE_CHECKOUT=demo

# Postgres (optional locally, REQUIRED when deployed: Render's disk is wiped on every restart).
# Leave empty to use local JSON files in .data/. On first start with a database, .data/ is imported automatically.
# Free option: Neon (neon.tech) -> copy the connection string.
DATABASE_URL=

# Clerk sign-in for shoppers (optional). Leave empty to use one-click demo sign-in only.
# dashboard.clerk.com -> your app -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AG Studio licence for the Insights dashboard (optional). Without it, Insights shows a trial watermark.
# ag-grid.com -> AG Studio trial
AG_STUDIO_LICENSE_KEY=
